     all|inji)      ports+=( 8082 8088 8091 8094 );;
   esac
+  case "$scenario" in
+    esignet)       ports+=( 8088 );;
+  esac
   case "$scenario" in
     all|credebl)
       if [[ "$(scenario_needs_credebl "$scenario")" == "yes" ]]; then
