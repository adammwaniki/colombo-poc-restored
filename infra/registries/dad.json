{
  "title": "Department of Agrarian Development — Cultivator & Land Registry",
  "authority": "Department of Agrarian Development (Agrarian.lk / GeoGoviya)",
  "home": "https://www.agrarian.gov.lk/",
  "server": "https://dad.registry.in-labs.cdpi.dev",
  "svc": "dad-registry",
  "description": "Authoritative register of cultivators and their land parcels — the source of truth for the **fertilizer-subsidy** use case.\n\nThis is a *registry of record*. A relying party (e.g. the subsidy office or the Divisional Secretariat) confirms a farmer's cultivation status and entitlement basis by querying this API directly — an alternative to a verifiable-credential presentation.",
  "entity": "cultivators",
  "entity_desc": "Cultivator and land-parcel records.",
  "model_name": "Cultivator",
  "key": "nationalId",
  "fields": [
    {"name": "nationalId", "type": "string", "required": true, "description": "National ID of the cultivator", "example": "80000006"},
    {"name": "fullName", "type": "string", "required": true, "description": "Full name", "example": "Fathima Marikar"},
    {"name": "farmId", "type": "string", "required": true, "description": "Land-parcel / farm identifier", "example": "LK-FARM-0006"},
    {"name": "region", "type": "string", "description": "District / region", "example": "Kurunegala"},
    {"name": "farmSizeHectares", "type": "number", "description": "Registered land area, hectares", "example": 2},
    {"name": "primaryCrops", "type": "string", "description": "Primary crops grown", "example": "Paddy"},
    {"name": "cultivationStatus", "type": "string", "description": "active | inactive this season", "example": "active"},
    {"name": "registeredOn", "type": "string", "description": "Enrolment date (YYYY-MM-DD)", "example": "2026-06-08"}
  ],
  "issuance": {
    "credential": "CultivatorCredential",
    "filter": {"cultivationStatus": "active"},
    "map": {
      "holder": "fullName",
      "nationalId": "nationalId",
      "farmId": "farmId",
      "location": "region",
      "hectares": "farmSizeHectares",
      "crops": "primaryCrops",
      "registeredOn": "registeredOn"
    }
  },
