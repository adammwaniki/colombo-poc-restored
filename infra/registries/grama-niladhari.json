{
  "title": "e-Grama Niladhari — Address Attestation Registry",
  "authority": "Ministry of Home Affairs — Grama Niladhari / Divisional Secretariats",
  "home": "https://www.moha.gov.lk/",
  "server": "https://grama-niladhari.registry.in-labs.cdpi.dev",
  "svc": "gn-registry",
  "description": "Authoritative register of Grama Niladhari address attestations — the source of truth for the GN **address proof** used in the business-permit use case.\n\nThe physical in-person address check stays manual; its outcome is recorded here. A relying party confirms a verified address by querying this API directly — **no verifiable credential required**.",
  "entity": "attestations",
  "entity_desc": "Grama Niladhari address attestations.",
  "model_name": "AddressAttestation",
  "key": "nationalId",
  "fields": [
    {"name": "nationalId", "type": "string", "required": true, "description": "National ID of the resident", "example": "80000001"},
    {"name": "fullName", "type": "string", "required": true, "description": "Full name", "example": "Nuwan Bandara"},
    {"name": "address", "type": "string", "required": true, "description": "Verified residential / business address", "example": "Colombo, Sri Lanka"},
    {"name": "gnDivision", "type": "string", "required": true, "description": "Grama Niladhari division", "example": "Colombo GN Division"},
    {"name": "attestationId", "type": "string", "required": true, "description": "Attestation reference", "example": "GN-2026-0001"},
    {"name": "verifiedOn", "type": "string", "description": "Date verified (YYYY-MM-DD)", "example": "2026-06-01"},
    {"name": "verifiedBy", "type": "string", "description": "Attesting Grama Niladhari officer", "example": "GN Officer, Colombo"}
  ],
  "issuance": {
    "credential": "AddressProofCredential",
    "map": {
      "holder": "fullName",
      "nationalId": "nationalId",
      "address": "address",
      "gnDivision": "gnDivision",
      "verifiedOn": "verifiedOn"
    }
  },
